# Copy to .env.local for local development.
# Points the frontend at your running backend (see /backend).

# Local dev: leave as-is if running the backend locally on its default port.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Production (Vercel): set this in the Vercel project's Environment
# Variables to your deployed Railway backend URL, e.g.
# NEXT_PUBLIC_API_URL=https://ekiro-backend-production.up.railway.app
