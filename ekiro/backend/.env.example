# Copy this file to .env and fill in real values.
# On Railway, set these as project Variables instead of committing a .env file.

# MongoDB Atlas connection string (see backend/README.md for how to get one)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-url>/ekiro?retryWrites=true&w=majority

# Port the Express server listens on. Railway sets this automatically in
# production — this default is only used for local development.
PORT=4000

# Comma-separated list of origins allowed to call this API (your deployed
# Vercel frontend URL, plus http://localhost:3000 for local dev).
CORS_ORIGINS=http://localhost:3000
